*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
california_housing.egg-info/
.installed.cfg
*.egg

# ==========================================
# Virtual Environments
# ==========================================
venv/
env/
.venv/
ENV/

# ==========================================
# Testing, Coverage & Linters
# ==========================================
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/
.ruff_cache/
.mypy_cache/

# ==========================================
# Large Model Artifacts (> 100MB GitHub limit)
# ==========================================
models/*.joblib
models/*.pkl
models/*.h5
models/*.onnx
!models/model_metadata.json
!models/.gitkeep

# ==========================================
# MLflow Artifacts & Databases
# ==========================================
mlruns/
models/mlruns/
mlflow.db
*.db
*.sqlite3
backend/history.db
history.db

# ==========================================
# Generated Drift Reports & Logs
# ==========================================
data/drift_reports/*.json
!data/drift_reports/.gitkeep
logs/
*.log

# ==========================================
# Frontend Node / React
# ==========================================
frontend/node_modules/
frontend/dist/
frontend/.env
node_modules/

# ==========================================
# IDEs & Operating Systems
# ==========================================
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db

# ==========================================
# Secrets & Environment Variables
# ==========================================
.env
.env.*.local
