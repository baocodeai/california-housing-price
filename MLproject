name: california_housing_mlops

entry_points:
  data:
    command: "python src/data/splitting.py"

  train:
    parameters:
      config: {type: str, default: "configs/stacking.yaml"}
    command: "python -m src.models.stacking.train --config {config}"

  evaluate:
    command: "python src/visualization/evaluation.py"

  predict:
    parameters:
      input_path: {type: str, default: "data/external/sample_houses.json"}
    command: "python -m src.models.stacking.predict --input {input_path}"
